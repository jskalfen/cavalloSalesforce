<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Since_Last_Human_Contact__c</fullName>
    <description>Number of days since the last qualifying EAC activity. Null when no activity has been recorded.</description>
    <formula>IF(ISBLANK(Last_Human_Contact__c), NULL, TODAY() - DATEVALUE(Last_Human_Contact__c))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Since Last Human Contact</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <type>Number</type>
</CustomField>
